# TEMPLATE ONLY — copy to .env and fill in there.
#
#   cp .env.example .env
#
# This file IS committed to git. Only .env is ignored, so a real key placed
# here is published. Placeholders only.
#
# Every value below is optional: with no .env at all the server still boots
# and serves summaries from the local mock provider.

# Port the API listens on.
PORT=3000

# Origin allowed by CORS. Defaults to the Angular dev server.
CORS_ORIGIN=http://localhost:4200

# --- AI provider (any OpenAI-compatible chat-completions endpoint) ---

# Free Groq key from https://console.groq.com/keys — no credit card required.
# When absent, the server uses the mock summary provider and reports
# "aiProvider": "mock" on GET /api/health.
AI_API_KEY=your_api_key_here

# Change these two to switch vendor or model — no code change required.
# Groq (default):  https://api.groq.com/openai/v1
# OpenRouter:      https://openrouter.ai/api/v1
# Together AI:     https://api.together.xyz/v1
# Local Ollama:    http://localhost:11434/v1
AI_BASE_URL=https://api.groq.com/openai/v1

# Groq production models:
#   llama-3.3-70b-versatile   (default — best instruction following)
#   openai/gpt-oss-120b       (Apache 2.0, if OSI licensing is required)
#   llama-3.1-8b-instant      (fastest, highest free limits)
AI_MODEL=llama-3.3-70b-versatile

# --- GitHub MCP integration (optional bonus feature) ---
#
# Entirely optional. Left disabled, the app behaves exactly as it does without
# any of these settings — the GitHub panel simply does not appear.

# Master switch. Anything other than "true" disables the integration.
MCP_ENABLED=false

# GitHub personal access token: https://github.com/settings/tokens
# Use the SMALLEST scope that works — this feature only reads:
#   public repo  -> "public_repo"  (classic), or a fine-grained token with
#                   read-only Contents + Issues + Pull requests
#   private repo -> "repo"
GITHUB_TOKEN=your_github_token_here

# Which repository to read. Fixed here on purpose — these are never accepted
# from the client, or the API would become a proxy to any repo the token sees.
GITHUB_OWNER=your_github_username
GITHUB_REPO=your_repository_name

# Optional. Blank means the repository's default branch.
GITHUB_BRANCH=

# GitHub's hosted MCP server. Point at a local one to switch, e.g.
# http://localhost:8080/mcp when running ghcr.io/github/github-mcp-server.
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
